# Only EXPO_PUBLIC_* values are bundled into the app. Never put secrets here.
# Use your machine's LAN IP when testing on a physical device, e.g. http://192.168.1.20:3002/api
EXPO_PUBLIC_API_URL="http://localhost:3002/api"

# Anonymous usage analytics (doc 27 F7.2). Leave empty to send nothing.
# PostHog-compatible capture API, e.g. https://eu.i.posthog.com and a project key.
EXPO_PUBLIC_ANALYTICS_HOST=""
EXPO_PUBLIC_ANALYTICS_KEY=""
