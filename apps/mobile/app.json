{
  "expo": {
    "name": "Fixli",
    "slug": "fixli",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fixli",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1F5F9",
      "dark": {
        "image": "./assets/images/logo-dark.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A1228"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixli.app",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.fixli.app",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F1F5F9",
          "dark": {
            "image": "./assets/images/logo-dark.png",
            "backgroundColor": "#0A1228"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Fixli uses the microphone only when you hold the button to describe your problem by voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fixli uses the camera when you take a photo of the problem, your ID, or your work.",
          "photosPermission": "Fixli opens your photos when you choose a picture of the problem or your work."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fixli uses your location to fill in your address and find professionals near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007BFF",
          "defaultChannel": "default"
        }
      ],
      "expo-image",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5983299f-7f05-4986-aba3-51431b22cd50"
      }
    },
    "owner": "akifkhan0375"
  }
}
