{
  "name": "@fixli/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo 'Mobile build handled by EAS'",
    "lint": "oxlint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf .expo node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.4.2",
    "@expo/dom-webview": "^58.0.2",
    "@expo/metro-runtime": "^58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@fixli/shared": "workspace:*",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/drawer": "^7.5.5",
    "@react-navigation/native": "^7.1.16",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react-native": "~8.28.1",
    "axios": "^1.7.0",
    "expo": "~58.1.0",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "^58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.23",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.23",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "~15.16.0",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "oxlint": "^1.81.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!.*((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@reduxjs/toolkit|immer|react-redux|redux|reselect|@fixli/shared))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/App.tsx",
      "!src/navigation/**",
      "!src/theme/**"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 30,
        "branches": 24,
        "functions": 20,
        "lines": 31
      }
    }
  }
}
