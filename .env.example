# Copy to .env at the repo root (docker compose) and apps/api/.env (local API).
# Never commit real values. Generate a secret with: openssl rand -base64 48

# Database (docker compose service "postgres", published on host port 5434)
POSTGRES_USER=fixli
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=fixli

# API
DATABASE_URL="postgresql://fixli:change-me-db-password@localhost:5434/fixli?schema=public"
JWT_SECRET=""
# Encrypts identity numbers (CNIC) at rest. REQUIRED in production. Generate: openssl rand -base64 32
# Losing this key makes stored ID numbers unreadable: back it up in a secrets manager.
FIELD_ENCRYPTION_KEY=""
# Signup needs a texted code. Defaults to true in production, false elsewhere. Production also needs an SMS
# provider (doc 25 O5); without one /auth/phone/start returns 503 SMS_UNAVAILABLE rather than pretending to send.
OTP_REQUIRED=""
# Roadmap APIs with no finished app yet; hidden (404) unless listed: recurring_jobs,properties,service_packages,subscriptions
ENABLED_FEATURES=""
# Access token lifetime (short); the refresh token keeps people signed in
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
# Countries where signup is open. Pakistan first; add others (e.g. PK,AE) only after legal review.
ENABLED_COUNTRIES="PK"
PORT=3002
NODE_ENV="development"
LOG_LEVEL="info"
# Required in production: the browser origin(s) allowed by CORS
FRONTEND_URL=""

# Gemini AI (server only, never ship to the mobile app)
GEMINI_API_KEY=""

# pgAdmin (dev only)
PGADMIN_EMAIL=admin@fixli.dev
PGADMIN_PASSWORD=change-me-pgadmin

# File storage for photos and ID documents.
# local = write to disk (development). s3 = any S3-compatible bucket (required in production).
STORAGE_DRIVER="local"
# Public base URL of THIS api including /api, as reachable from the phone (use your LAN IP when testing on a device)
PUBLIC_API_URL="http://localhost:3002/api"
# S3 settings (only when STORAGE_DRIVER=s3). Verification documents must live in a PRIVATE bucket/prefix;
# only avatar/ and portfolio/ may be publicly readable.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Matching and offers (owner decision O3 in docs/25; these are the recommended defaults)
MATCH_NOTIFY_LIMIT=10
MAX_OFFERS_SHOWN=3
OFFER_TTL_MINUTES=10
REMATCH_AFTER_MINUTES=15
REMATCH_RADIUS_FACTOR=1.5
# Background sweepers (offer expiry, re-matching, auto-confirm, location retention). Safe on several instances (lease).
RUN_BACKGROUND_JOBS=true

# ── Jobs on site (doc 27 F2) ─────────────────────────────────
# Start needs a before photo and Finish an after photo, or a stated reason.
REQUIRE_JOB_PHOTOS=true
# A finished job the customer doesn't confirm completes by itself after this (D-F2).
AUTO_CONFIRM_HOURS=24
# Cash the worker marked and the customer didn't answer is confirmed after this (D-F2).
CASH_AUTO_CONFIRM_HOURS=48
# Worker location points are deleted after this many days (D-F3).
LOCATION_RETENTION_DAYS=30
# Straight-line ETA speed until a routing provider is set up.
AVG_TRAVEL_SPEED_KMH=20

# ── SOS (doc 27 F5) ─────────────────────────────────────────
# Property emergencies go to the nearest free worker first, one at a time.
SOS_ACCEPT_SECONDS=180
SOS_DIRECT_TRIES=3
# Trusted-contact SOS texts. (Text provider settings are under "Text messages" below.)

# ── Text messages: sign-up / sign-in codes and SOS alerts ───
# none (nothing is sent; production refuses to issue codes) or twilio.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sending number (+1…) or Messaging Service id (MG…). With Twilio test credentials use +15005550006.
TWILIO_FROM=

# ── Card payments for project stages ────────────────────────
# none (projects are paid directly) or stripe. Stripe does not onboard businesses in Pakistan: use it
# for staging or a supported market. Outside production only test keys are accepted.
# Local webhooks: stripe listen --forward-to localhost:3002/api/payments/stripe/webhook
PAYMENTS_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A submitted project stage the customer doesn't answer is approved after this many days.
PROJECT_AUTO_APPROVE_DAYS=7
# Reads the ID number from a worker's ID photo using the AI provider. Sends an identity document to
# that provider: leave false until the data-processing decision (docs/25 O9) allows it.
AI_ID_OCR_ENABLED=false

# ── Realtime & notifications ────────────────────────────────
# Required when running more than one API instance: live events and rate limits are shared
# through Redis. Leave empty for a single instance.
REDIS_URL=
# Expo push service. The access token is only needed if "enhanced push security" is on in Expo.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# ── Staff security ──────────────────────────────────────────
# Staff sign in with password + authenticator code. Only tests may turn this off.
ADMIN_TOTP_REQUIRED=true
# Encrypts staff authenticator secrets at rest. Required in production: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# ── Monitoring (doc 27 F8.2) ────────────────────────────────
# Crash reports (Sentry). Empty = nothing is reported. Personal data is removed before sending.
SENTRY_DSN=
# Environment name shown on each report (staging / production).
SENTRY_ENVIRONMENT=
# Release shown on each report so a bug can be tied to a deploy: usually the git commit. CI sets it.
APP_RELEASE=
# Lets monitoring read socket count, memory and job heartbeats from /api/health/ready (header x-ops-token).
# At least 24 characters: openssl rand -base64 24. Empty = those details are never shown.
OPS_TOKEN=
# Mobile analytics (PostHog). Leave the key empty to send nothing. Events never carry phone, address, names or message text.
EXPO_PUBLIC_POSTHOG_KEY=""
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
